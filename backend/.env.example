PORT=3000
MONGODB_URI=mongodb://localhost:27017/isopod-grove

# Google OAuth (Google Cloud Console > 사용자 인증 정보에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# 로그인 후 리다이렉트할 프론트엔드 주소
FRONTEND_URL=http://localhost:5173

# JWT 서명 키 (openssl rand -hex 32 등으로 생성)
JWT_SECRET=

# 웹 푸시 알림용 VAPID 키. 비워 두면 푸시 알림만 꺼진 채로 서버는 정상 동작한다.
# 생성: npx web-push generate-vapid-keys  (비공개 키는 외부에 노출하면 안 된다)
# VAPID_SUBJECT는 푸시 서비스에 전달되는 연락처 URL(mailto: 또는 https:)이다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://example.com
