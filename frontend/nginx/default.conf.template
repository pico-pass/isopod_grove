# 컨테이너 시작 시 envsubst가 ${BACKEND_UPSTREAM}, ${DNS_RESOLVER}만 치환한다($uri 같은 nginx 변수는 그대로 둔다).

# 앞단(로드밸런서·리버스 프록시)이 보낸 X-Forwarded-Proto가 있으면 그대로 넘기고, 없으면 이 서버가 받은 스킴을 쓴다.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 컨테이너 상태 확인용(HEALTHCHECK, 로드밸런서)
    location = /healthz {
        access_log off;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 "ok\n";
    }

    # API → 백엔드. 변수로 지정하면 nginx가 시작할 때가 아니라 요청이 올 때 주소를 찾아서,
    # 백엔드보다 먼저 떠도 시작에 실패하지 않는다(그래서 resolver가 필요하다). URI는 /api/... 그대로 넘어간다.
    # 정규식 location이라 /api 와 /api/... 가 모두 여기로 온다(prefix location이면 /api 요청이 /api/로 리다이렉트된다).
    location ~ ^/api(/|$) {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $backend_upstream "${BACKEND_UPSTREAM}";
        proxy_pass http://$backend_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 60s;
    }

    # 해시가 붙은 빌드 결과물(index-AbCd1234.js 등)은 내용이 바뀌면 이름도 바뀌므로 1년간 캐시해도 안전하다.
    location ~* "^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # 그 밖의 정적 파일(종 이미지 등)은 이름이 고정이라 짧게만 캐시한다.
    location /assets/ {
        add_header Cache-Control "public, max-age=604800";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # index.html과 서비스 워커는 항상 최신 것을 받아야 새 배포(와 푸시 알림)가 바로 반영된다.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # 그 밖의 주소(/friends 같은 화면 경로)는 SPA가 처리하도록 index.html을 돌려준다.
    location / {
        try_files $uri /index.html;
    }
}
